# ---- Core API ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/sentinelpay
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---- Kafka (event backbone) ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=sentinelpay-api
KAFKA_ENABLED=false

# ---- Fraud scoring engine ----
FRAUD_ENGINE_URL=http://localhost:8000

# ---- Seeded admin account ----
ADMIN_EMAIL=admin@sentinelpay.local
ADMIN_PASSWORD=Admin123!

# ---- Databricks (lake ingest bridge) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_VOLUME_PATH=/Volumes/fraud/landing/events
DATABRICKS_CATALOG=fraud
DATABRICKS_SCHEMA=analytics

# ---- Lake bridge ----
KAFKA_TOPICS=txn.events.raw,txn.fraud.scored,txn.status.updates,user.activity,security.events
BRIDGE_BATCH_SECONDS=30
BRIDGE_GROUP_ID=lake-ingest-bridge
